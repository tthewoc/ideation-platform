{
  "name": "ideator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "migrate": "tsx scripts/migrate.ts",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx src/server/main.ts",
    "worker": "tsx src/server/worker.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run build && npm test",
    "test:graph-load": "tsx scripts/graph-load-check.ts",
    "test:restore": "tsx scripts/restore-check.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" *.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"scripts/**/*.ts\" \"tests/**/*.ts\" *.ts",
    "evaluate": "tsx scripts/evaluate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.10",
    "fastify": "5.12.8",
    "oidc-provider": "9.14.0",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/oidc-provider": "9.13.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
